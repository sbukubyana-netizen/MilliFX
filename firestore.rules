rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for common validations
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for Love Note sticky notes
    function isValidLoveNote(data) {
      return data.keys().hasAll(['id', 'sender', 'color', 'createdAt', 'tilt'])
        && data.id is string && data.id.size() <= 100
        && data.sender is string && (data.sender == 'Milli 🤍' || data.sender == 'Fix 🤍' || data.sender == 'Us 🤍' || data.sender == 'Sbu 🤍')
        && data.color is string && data.color.size() <= 200
        && data.createdAt is string && data.createdAt.size() <= 50
        && (data.tilt is int || data.tilt is float)
        && (!data.keys().hasAny(['text']) || (data.text is string && data.text.size() <= 1000))
        && (!data.keys().hasAny(['audioUrl']) || (data.audioUrl is string && data.audioUrl.size() <= 1200000))
        && (!data.keys().hasAny(['audioDuration']) || (data.audioDuration is int || data.audioDuration is float));
    }

    // Validation for Song Dedications
    function isValidSongDedication(data) {
      return data.keys().hasAll(['id', 'songTitle', 'from', 'to', 'message', 'timestamp', 'sticker'])
        && data.keys().size() == 7
        && data.id is string && data.id.size() <= 100
        && data.songTitle is string && data.songTitle.size() <= 200
        && data.from is string && data.from.size() <= 100
        && data.to is string && data.to.size() <= 100
        && data.message is string && data.message.size() <= 1000
        && data.timestamp is string && data.timestamp.size() <= 50
        && data.sticker is string && (data.sticker == 'heart' || data.sticker == 'star' || data.sticker == 'rose' || data.sticker == 'fire');
    }

    // Validation for Custom Episodes
    function isValidCustomEpisode(data) {
      return data.keys().hasAll(['id', 'title', 'description', 'category', 'previewImageUrl', 'images'])
        && data.id is string && data.id.size() <= 100
        && data.title is string && data.title.size() <= 200
        && data.description is string && data.description.size() <= 500
        && data.category is string && data.category.size() <= 200
        && data.previewImageUrl is string && data.previewImageUrl.size() <= 1200000
        && data.images is list;
    }

    // Validation for Live Locations
    function isValidLiveLocation(data) {
      return data.keys().hasAll(['id', 'name', 'lat', 'lng', 'isSharing', 'updatedAt'])
        && data.id is string && data.id.size() <= 100
        && data.name is string && data.name.size() <= 100
        && (data.lat is int || data.lat is float)
        && (data.lng is int || data.lng is float)
        && data.isSharing is bool
        && data.updatedAt is string && data.updatedAt.size() <= 100
        && (!data.keys().hasAny(['batteryLevel']) || data.batteryLevel is int || data.batteryLevel is float)
        && (!data.keys().hasAny(['statusMessage']) || (data.statusMessage is string && data.statusMessage.size() <= 200));
    }

    // Validation for Daily Notes
    function isValidDailyNote(data) {
      return data.keys().hasAll(['id', 'subject', 'body', 'period', 'profile', 'createdAt'])
        && data.keys().size() == 6
        && data.id is string && data.id.size() <= 100
        && data.subject is string && data.subject.size() <= 200
        && data.body is string && data.body.size() <= 1000
        && data.period is string && (data.period == 'morning' || data.period == 'afternoon' || data.period == 'evening' || data.period == 'night')
        && data.profile is string && (data.profile == 'Girlfriend' || data.profile == 'Boyfriend')
        && data.createdAt is string && data.createdAt.size() <= 100;
    }

    // Validation for Studio Settings
    function isValidStudioSetting(data) {
      return data.keys().hasAll(['id', 'trailerVideoUrl', 'boyfriendProfileImage', 'girlfriendProfileImage', 'bannerVideos', 'boyfriendBannerVideos', 'girlfriendBannerVideos'])
        && data.id is string && data.id.size() <= 100
        && data.trailerVideoUrl is string && data.trailerVideoUrl.size() <= 1200000
        && data.boyfriendProfileImage is string && data.boyfriendProfileImage.size() <= 1200000
        && data.girlfriendProfileImage is string && data.girlfriendProfileImage.size() <= 1200000
        && data.bannerVideos is list
        && data.boyfriendBannerVideos is list
        && data.girlfriendBannerVideos is list
        && (!data.keys().hasAny(['usProfileImage']) || (data.usProfileImage is string && data.usProfileImage.size() <= 1200000))
        && (!data.keys().hasAny(['usBannerVideos']) || data.usBannerVideos is list)
        && (!data.keys().hasAny(['backgroundSoundEnabled']) || data.backgroundSoundEnabled is bool)
        && (!data.keys().hasAny(['colorTheme']) || (data.colorTheme is string && data.colorTheme.size() <= 100));
    }

    // Validation for What to do Together items
    function isValidWhatToDo(data) {
      return data.keys().hasAll(['id', 'text', 'completed', 'createdAt', 'createdBy'])
        && data.keys().size() == 5
        && data.id is string && data.id.size() <= 100
        && data.text is string && data.text.size() <= 500
        && data.completed is bool
        && data.createdAt is string && data.createdAt.size() <= 100
        && data.createdBy is string && data.createdBy.size() <= 100;
    }

    // Validation for Love Jar Note items
    function isValidLoveJarNote(data) {
      return data.keys().hasAll(['id', 'text', 'sender', 'createdAt', 'opened'])
        && data.id is string && data.id.size() <= 100
        && data.text is string && data.text.size() <= 1000
        && data.sender is string && data.sender.size() <= 100
        && data.createdAt is string && data.createdAt.size() <= 100
        && data.opened is bool
        && (!data.keys().hasAny(['openedAt']) || (data.openedAt is string && data.openedAt.size() <= 100))
        && (!data.keys().hasAny(['recipient']) || (data.recipient is string && data.recipient.size() <= 100));
    }

    // Rules for love_notes collection
    match /love_notes/{noteId} {
      allow read: if true;
      allow create: if isValidId(noteId) && isValidLoveNote(incoming()) && incoming().id == noteId;
      allow update: if isValidId(noteId) && isValidLoveNote(incoming()) && incoming().id == noteId;
      allow delete: if isValidId(noteId);
    }

    // Rules for song_dedications collection
    match /song_dedications/{dedicationId} {
      allow read: if true;
      allow create: if isValidId(dedicationId) && isValidSongDedication(incoming()) && incoming().id == dedicationId;
      allow update: if isValidId(dedicationId) && isValidSongDedication(incoming()) && incoming().id == dedicationId;
      allow delete: if isValidId(dedicationId);
    }

    // Rules for custom_episodes collection
    match /custom_episodes/{episodeId} {
      allow read: if true;
      allow create: if isValidId(episodeId) && isValidCustomEpisode(incoming()) && incoming().id == episodeId;
      allow update: if isValidId(episodeId) && isValidCustomEpisode(incoming()) && incoming().id == episodeId;
      allow delete: if isValidId(episodeId);
    }

    // Rules for daily_notes collection
    match /daily_notes/{noteId} {
      allow read: if true;
      allow create: if isValidId(noteId) && isValidDailyNote(incoming()) && incoming().id == noteId;
      allow update: if isValidId(noteId) && isValidDailyNote(incoming()) && incoming().id == noteId;
      allow delete: if isValidId(noteId);
    }

    // Rules for live_locations collection
    match /live_locations/{locationId} {
      allow read: if true;
      allow create: if isValidId(locationId) && isValidLiveLocation(incoming()) && incoming().id == locationId;
      allow update: if isValidId(locationId) && isValidLiveLocation(incoming()) && incoming().id == locationId;
      allow delete: if isValidId(locationId);
    }

    // Rules for studio_settings collection
    match /studio_settings/{configId} {
      allow read: if true;
      allow create: if isValidId(configId) && isValidStudioSetting(incoming()) && incoming().id == configId;
      allow update: if isValidId(configId) && isValidStudioSetting(incoming()) && incoming().id == configId;
      allow delete: if isValidId(configId);
    }

    // Rules for what_to_do_together collection
    match /what_to_do_together/{itemId} {
      allow read: if true;
      allow create: if isValidId(itemId) && isValidWhatToDo(incoming()) && incoming().id == itemId;
      allow update: if isValidId(itemId) && isValidWhatToDo(incoming()) && incoming().id == itemId;
      allow delete: if isValidId(itemId);
    }

    // Rules for love_jar_notes collection
    match /love_jar_notes/{itemId} {
      allow read: if true;
      allow create: if isValidId(itemId) && isValidLoveJarNote(incoming()) && incoming().id == itemId;
      allow update: if isValidId(itemId) && isValidLoveJarNote(incoming()) && incoming().id == itemId;
      allow delete: if isValidId(itemId);
    }
  }
}
