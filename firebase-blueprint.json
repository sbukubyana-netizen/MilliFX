{
  "entities": {
    "love_note": {
      "title": "Love Note",
      "description": "Sticky note message pinned on the cozy corner corkboard",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "audioUrl": { "type": "string" },
        "audioDuration": { "type": "number" },
        "sender": { "type": "string", "enum": ["Milli 🤍", "Fix 🤍", "Us 🤍", "Sbu 🤍"] },
        "color": { "type": "string" },
        "createdAt": { "type": "string" },
        "tilt": { "type": "number" }
      },
      "required": ["id", "sender", "color", "createdAt", "tilt"]
    },
    "song_dedication": {
      "title": "Song & Media Dedication",
      "description": "Heartfelt media & song dedication accepting Spotify/YouTube links, voice note recordings, or love letters",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "songTitle": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" },
        "sticker": { "type": "string" },
        "type": { "type": "string", "enum": ["link", "voice", "text"] },
        "linkUrl": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "audioData": { "type": "string" },
        "audioDuration": { "type": "number" },
        "mediaPlatform": { "type": "string", "enum": ["youtube", "spotify", "other"] }
      },
      "required": ["id", "songTitle", "from", "to", "message", "timestamp", "sticker"]
    },
    "custom_episode": {
      "title": "Custom Episode",
      "description": "Custom user entered episode containing a list of custom pictures or videos",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "previewImageUrl": { "type": "string" },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "imageUrl": { "type": "string" },
              "videoUrl": { "type": "string" },
              "description": { "type": "string" }
            },
            "required": ["id", "title", "imageUrl"]
          }
        }
      },
      "required": ["id", "title", "description", "category", "previewImageUrl", "images"]
    },
    "live_location": {
      "title": "Live Location",
      "description": "Real-time location coordinates and sharing status for Milli and Fix",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "isSharing": { "type": "boolean" },
        "updatedAt": { "type": "string" },
        "batteryLevel": { "type": "number" },
        "statusMessage": { "type": "string" }
      },
      "required": ["id", "name", "lat", "lng", "isSharing", "updatedAt"]
    },
    "daily_note": {
      "title": "Daily Note",
      "description": "Custom daily thought created by Millennium or Fix to sync on active panels",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subject": { "type": "string" },
        "body": { "type": "string" },
        "period": { "type": "string", "enum": ["morning", "afternoon", "evening", "night"] },
        "profile": { "type": "string", "enum": ["Girlfriend", "Boyfriend"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "subject", "body", "period", "profile", "createdAt"]
    },
    "studio_setting": {
      "title": "Studio Setting",
      "description": "Custom global settings for trailer, profiles, and banners",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "trailerVideoUrl": { "type": "string" },
        "boyfriendProfileImage": { "type": "string" },
        "girlfriendProfileImage": { "type": "string" },
        "bannerVideos": {
          "type": "array",
          "items": { "type": "string" }
        },
        "boyfriendBannerVideos": {
          "type": "array",
          "items": { "type": "string" }
        },
        "girlfriendBannerVideos": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["id", "trailerVideoUrl", "boyfriendProfileImage", "girlfriendProfileImage", "bannerVideos", "boyfriendBannerVideos", "girlfriendBannerVideos"]
    },
    "what_to_do_item": {
      "title": "What To Do Together Item",
      "description": "Interactive checklist item for couple tasks, future dates, and shared buckets",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "completed": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "text", "completed", "createdAt", "createdBy"]
    },
    "love_jar_note": {
      "title": "Love Jar Note",
      "description": "A custom love letter, secret, or affectionate note dropped into the digital Love Jar",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "sender": { "type": "string" },
        "createdAt": { "type": "string" },
        "opened": { "type": "boolean" },
        "openedAt": { "type": "string" },
        "recipient": { "type": "string" }
      },
      "required": ["id", "text", "sender", "createdAt", "opened"]
    },
    "custom_category": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "profile": { "type": "string" },
        "createdAt": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["id", "name", "createdAt"]
    },
    "credits_config": {
      "title": "Credits Configuration",
      "description": "Customizable credits cast, categories, and background video or image",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bgType": { "type": "string", "enum": ["none", "video", "image"] },
        "bgMediaUrl": { "type": "string" },
        "bgOpacity": { "type": "number" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "quote": { "type": "string" },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": { "type": "string" },
              "entries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "role": { "type": "string" },
                    "name": { "type": "string" },
                    "note": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "updatedAt"]
    }
  },
  "firestore": {
    "love_notes": {
      "schema": "love_note",
      "description": "Collection of sweet sticky notes shared between Milli and Fix"
    },
    "song_dedications": {
      "schema": "song_dedication",
      "description": "Collection of romantic song dedications and vinyl memory logs"
    },
    "custom_episodes": {
      "schema": "custom_episode",
      "description": "Collection of user-added episodes containing pictures/videos and custom captions"
    },
    "daily_notes": {
      "schema": "daily_note",
      "description": "Collection of sweet custom periodically matched notes written by lovers"
    },
    "live_locations": {
      "schema": "live_location",
      "description": "Real-time active location updates synced between Milli and Fix"
    },
    "studio_settings": {
      "schema": "studio_setting",
      "description": "Customizable studio configurations for trailer videos, profile cards, and banners"
    },
    "what_to_do_together": {
      "schema": "what_to_do_item",
      "description": "Interactive checklist tasks left by lovers of what they must do together"
    },
    "love_jar_notes": {
      "schema": "love_jar_note",
      "description": "Custom secret messages dropped inside the digital corked jar to shake and uncork once every 24 hours"
    },
    "custom_categories": {
      "schema": "custom_category",
      "description": "User-created categories for organizing media rows that sync across the app and settings"
    },
    "credits_config": {
      "schema": "credits_config",
      "description": "Custom credits information, cast entries, and background media settings"
    }
  }
}
